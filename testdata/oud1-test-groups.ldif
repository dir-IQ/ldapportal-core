# =============================================================================
# oud1-test-groups.ldif — representative group memberships for the 100 test
# users in oud1-test-users.ldif.
#
# Base DN:  dc=oud1,dc=example,dc=com
# Loads into: ou=Groups,dc=oud1,dc=example,dc=com
# Group type: groupOfUniqueNames / uniqueMember (OUD / OpenDJ convention,
#   matches testdata/oud-bootstrap.ldif).
#
# Groups:
#   - 5 department groups (Engineering, Sales, Marketing, HumanResources,
#     Finance) — 20 members each.
#   - AllEmployees           — all 100 users.
#   - Managers               — the 10 department managers.
#   - RemoteAccess           — a representative cross-department subset.
#   - SecurityAdmins         — a small subset PLUS a NESTED group membership
#                              (contains cn=Managers as a uniqueMember), to
#                              exercise nested-group resolution (isMemberOf).
#
# Load AFTER oud1-test-users.ldif so the referenced user entries exist:
#   ldapadd -c -x -H ldap://localhost:3389 \
#     -D "cn=Directory Manager" -w <password> -f testdata/oud1-test-groups.ldif
# =============================================================================

dn: ou=Groups,dc=oud1,dc=example,dc=com
objectClass: top
objectClass: organizationalUnit
ou: Groups
description: Test security and distribution groups for the oud1 directory

dn: cn=Engineering,ou=Groups,dc=oud1,dc=example,dc=com
objectClass: top
objectClass: groupOfUniqueNames
cn: Engineering
description: Engineering department — all Engineering staff and managers.
