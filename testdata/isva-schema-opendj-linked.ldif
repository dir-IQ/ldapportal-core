attributeTypes: ( 1.3.6.1.4.1.7611.99.5.5 NAME 'FRITLEID' DESC 'Legal Entity Identifier for the Entity' EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{256} SINGLE-VALUE X-ORIGIN 'user defined' )
attributeTypes: ( 2.16.128.113533.1.1400.2 NAME 'thumbNailLogo' DESC 'Thumbnail logo assoicated with a user.' SYNTAX 1.3.6.1.4.1.1466.115.121.1.5 X-ORIGIN 'user defined' )
attributeTypes: ( 1.3.18.0.2.4.463 NAME 'passwordDictFiles' DESC ' ' SYNTAX 1.3.6.1.4.1.1466.115.121.1.26 X-ORIGIN 'user defined' )
attributeTypes: ( 1.3.6.1.4.1.4228.1.23 NAME 'secCertSerialNumber' DESC 'The serial number of the current certificate used by this principal.' SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE X-ORIGIN 'user defined' )
attributeTypes: ( 1.3.18.0.2.4.285 NAME 'aclEntry' DESC 'Holds the access controls for entries in an IBM eNetwork LDAP directory' EQUALITY 2.5.13.2 SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 USAGE directoryOperation X-ORIGIN 'user defined' )
attributeTypes: ( 1.3.6.1.4.1.7611.0.1.1125 NAME 'FRITParentDomain' DESC 'Administrative Parent Domain of user. This attribute is used to route work tickets to the proper administrative domain.' EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{256} X-ORIGIN 'user defined' )
attributeTypes: ( 2.16.840.1.113730.3.1.97  NAME 'passwordMaxAge'  DESC 'Sun ONE defined password policy attribute type'  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15  X-DS-USE 'internal'  X-ORIGIN 'Sun ONE Directory Server' )
attributeTypes: ( 2.16.840.1.113730.3.1.99  NAME 'passwordMinLength'  DESC 'Sun ONE defined password policy attribute type' SYNTAX 1.3.6.1.4.1.1466.115.121.1.15  X-DS-USE 'internal' X-ORIGIN 'Sun ONE Directory Server' )
attributeTypes: ( 2.16.840.1.113730.3.1.222 NAME 'passwordMinAge'  DESC 'Sun ONE defined password policy attribute type'  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15  X-DS-USE 'internal' X-ORIGIN 'Sun ONE Directory Server' )
attributeTypes: ( 12.12.123.12 NAME 'nsRoleDN'  DESC 'ODSEE role attribute' SYNTAX 1.3.6.1.4.1.1466.115.121.1.12 )
attributeTypes: ( 12.12.123.14 NAME 'nsRole'  DESC 'ODSEE role attribute' SYNTAX 1.3.6.1.4.1.1466.115.121.1.12 X-ORIGIN 'Sun ONE Directory Server' )
attributeTypes: ( 1.3.18.0.2.4.142  NAME 'tsName'  DESC 'Used to specify the name of an eTargetService object.'  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )
attributeTypes: ( 1.3.18.0.2.4.137  NAME 'optIdentifier'  DESC 'Indicates Optional Identifiers and the values needed for GSO target.'  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )
attributeTypes: ( 1.3.18.0.2.4.135  NAME 'reqIdentifier'  DESC 'Indicates Required Identifiers and the values needed for GSO target.'  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )
attributeTypes: ( 1.3.18.0.2.4.139 NAME 'launchable' DESC 'Indicates whether this GSO target can be started by GSO or not.' SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE )
attributeTypes: ( 1.3.18.0.2.4.325 NAME 'settingID' DESC 'A naming attribute to identify cimSetting-derived objects.' SYNTAX 1.3.6.1.4.1.1466.115.121.1.15  SINGLE-VALUE )
attributeTypes: ( 1.3.18.0.2.4.133 NAME 'targetAdapter' DESC 'Indicates the specific target adapter to use for this GSO target.' SYNTAX 1.3.6.1.4.1.1466.115.121.1.12 SINGLE-VALUE )
attributeTypes: ( 1.3.18.0.2.4.138 NAME 'passwordGenerator' DESC 'Indicates the name of the Password Generator.' SYNTAX 1.3.6.1.4.1.1466.115.121.1.12 SINGLE-VALUE )
attributeTypes: ( 1.3.18.0.2.4.130 NAME 'accountService' DESC 'Indicates the service which is used to manage the target account.' SYNTAX 1.3.6.1.4.1.1466.115.121.1.12 SINGLE-VALUE )
attributeTypes: ( 1.3.18.0.2.4.129 NAME 'autoTerminate' DESC 'Indicates that this target should be stopped when the GSO user logs off.' SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE )
attributeTypes: ( 1.3.18.0.2.4.127 NAME 'prereqTarget' DESC 'Indicates a list of targets which are prerequisites of this target.' SYNTAX 1.3.6.1.4.1.1466.115.121.1.12 )
attributeTypes: ( 1.3.18.0.2.4.128 NAME 'autoInitiate' DESC 'Indicates that this target should be launched when the GSO user logs on.' SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE )
objectClasses: ( 1.2.840.113533.7.67.0 NAME 'entrustUser' SUP top STRUCTURAL MAY ( userCertificate $ bipPrintLocation ) X-ORIGIN 'user defined' )
objectClasses: ( 1.2.840.113533.7.67.1 NAME 'entrustCA' DESC 'Used to configure directory entries representing Entrust/Authority Certification Authorities.' SUP top AUXILIARY MAY ( attributeCertificate $ authorityRevocationList $ cACertificate $ certificateRevocationList $ crossCertificatePair $ userPassword ) X-ORIGIN 'user defined' )
objectClasses: ( 1.2.840.113533.7.67.12 NAME 'pKCS10Device' DESC 'Used by theEntrust/VPN Connector to search for PKCS \2310 enabled devices in the directory.' SUP top AUXILIARY MAY serialNumber X-ORIGIN 'user defined' )
objectClasses: ( 1.2.840.113533.7.67.13 NAME 'entrustRoamingUser' DESC 'Used to identify a user as being a roaming user.' SUP top AUXILIARY MAY ( entrustRoamFileEncInfo $ entrustRoamingCAPAB $ entrustRoamingEOP $ entrustRoamingPAB $ entrustRoamingProfile $ entrustRoamingPRV $ entrustRoamingRecipList $ entrustRoamingSLA $ uid ) X-ORIGIN 'user defined' )
objectClasses: ( 1.2.840.113533.7.67.14 NAME 'entrustDNQualifierUser' DESC 'Not used by Entrust software, it is provided for convenience so that the dnQualifier attribute can be added to an entry.' SUP top AUXILIARY MAY dnQualifier X-ORIGIN 'user defined' )
objectClasses: ( 1.2.840.113533.7.67.15 NAME 'entrustNamedObject' DESC 'Used to allow a series of useful attributes commonly used for naming to e includedin an entry.' SUP top AUXILIARY MAY ( c $ cn $ dc $ dmdName $ generationQualifier $ givenName $ initials $ l $ name $ o $ ou $ sn $ st $ title ) X-ORIGIN 'user defined' )
objectClasses: ( 1.2.840.113533.7.67.16 NAME 'uniquelyQualifiedObject' DESC 'Provided for convenience to allow users to include attributes in entries whchcan be used to uniquely qualify an object.' SUP top AUXILIARY MAY ( description $ dnQualifier $ mail $ serialNumber $ uid ) X-ORIGIN 'user defined' )
objectClasses: ( 1.2.840.113533.7.67.17 NAME 'entrustPolicyObject' DESC 'Used to extend the schema for objects which contain policy information.' SUP top AUXILIARY MAY entrustPolicyCertificate X-ORIGIN 'user defined' )
objectClasses: ( 1.2.840.113533.7.67.4 NAME 'uniquelyIdentifiedUser' DESC 'Used to specify that an entry must contain a serialNumber attribute.' SUP top AUXILIARY MUST serialNumber X-ORIGIN 'user defined' )
objectClasses: ( 1.2.840.113533.7.67.5 NAME 'simpleAuthObject' DESC 'Uwed to allow an entry to contain a userPassword attribute.' SUP top AUXILIARY MUST userPassword X-ORIGIN 'user defined' )
objectClasses: ( 1.2.840.113533.7.67.7 NAME 'rfc822MailUser' DESC 'Used to allow rfc822Mailbox attributes to be added to an entry.' SUP top AUXILIARY MAY mail X-ORIGIN 'user defined' )
objectClasses: ( 1.2.840.113556.1.5.20 NAME 'leaf' DESC 'from Active Directoryschema' SUP top ABSTRACT X-ORIGIN 'user defined' )
objectClasses: ( 1.3.18.0.2.6.28 NAME 'container' DESC 'An object that can contain other objects.' SUP top STRUCTURAL MUST cn X-ORIGIN 'user defined' )
objectClasses: ( 1.3.18.0.2.6.74 NAME 'aliasObject' DESC 'Allows an object tobe known by more than one name.' SUP top AUXILIARY MUST aliasedObjectName X-ORIGIN 'user defined' )
objectClasses: ( 1.3.18.0.2.6.75 NAME 'accessGroup' DESC 'A group that is usedfor access control.' SUP top STRUCTURAL MUST ( cn $ member ) MAY ( businessCategory $ description $ o $ ou $ owner $ seeAlso ) X-ORIGIN 'user defined' )
objectClasses: ( 1.3.18.0.2.6.77 NAME 'namedACL' DESC '  ' SUP top STRUCTURAL X-ORIGIN 'user defined' )
objectClasses: ( 1.3.18.0.2.6.132 NAME 'cimManagedElement' DESC 'Based on the proposed CIM_ManagedElement object class, cimManagedElement  provides a basis for many of the system management object classes in the  IBM schema.' SUP top ABSTRACT MAY ( caption $ description ) X-ORIGIN 'user defined' )
objectClasses: ( 1.3.18.0.2.6.133 NAME 'cimManagedSystemElement' DESC 'Based on CIM_ManagedSystemElement, this class provides the abstract base class  for the CIM-derived system element object classes and defines the common  attributes thereof.' SUP cimManagedElement ABSTRACT MAY ( configPtr $ installDate) X-ORIGIN 'user defined' )
objectClasses: ( 1.3.18.0.2.6.129 NAME 'cimLogicalElement' DESC 'Based on CIM_LogicalElement, this class provides the abstract base class for  the CIM-derived logical elements.' SUP cimManagedSystemElement ABSTRACT X-ORIGIN 'user defined' )
objectClasses: ( 1.3.18.0.2.6.79 NAME 'eUser' DESC 'Based on the proposed CIM_Principal object class, the eUser object class is used to represent a persons (or service\27s or SAPs) relationship to a system or set of systems.  It can be used to provide a description for a certificate, to select from amonga set of user profiles, or sets of functions and roles.' SUP cimManagedElement STRUCTURAL MAY ( accessHint $ accountHint $ configPtr $ principalName $ userCertificate ) X-ORIGIN 'user defined' )
objectClasses: ( 1.3.18.0.2.6.81 NAME 'eSystem' DESC 'Based on CIM_System, this structural class provides the common system and subsystem aggregation attributes for administrative scope and contact information.  This object classis generally instantiated only for use as an administrative scoping container object.  The eSystem subclasses are instantiated to represent computer systems, operating systems and application systems.' SUP cimLogicalElement STRUCTURAL MAY ( nameFormat $ primaryOwnerContact $ primaryOwnerName $ sys $ systemRoles ) X-ORIGIN 'user defined' )
objectClasses: ( 1.3.18.0.2.6.84 NAME 'eApplicationSystem' DESC 'Based on CIM_ApplicationSystem, this structural class models application  subsystems that may span multiple computer systems or it may reside on a  single computer system.  Generally, the directory object entry represents an  administrativescope.' SUP eSystem STRUCTURAL MAY ( hostedSoftwarePtr $ osPtr ) X-ORIGIN 'user defined' )
objectClasses: ( 1.3.18.0.2.6.91 NAME 'ePasswordPolicy' DESC 'Defines a policy for password management.' SUP top STRUCTURAL MUST cn MAY ( maxFailedLogins $ numberWarnDays $ passwordCheckMethods $ passwordDictFiles $ passwordExpireTime $ passwordMaxRepeatedChars $ passwordMinAlphaChars $ passwordMinDiffChars $ passwordMinOtherChars $ passwordRegistry $ passwordReuseNum $ passwordTimeReuse $ timeExpireLockout $ passwordMaxAge $ passwordMinAge $ passwordMinLength ) X-ORIGIN 'user defined' )
objectClasses: ( 1.3.18.0.2.6.92 NAME 'resourceLimits' DESC 'Defines a policy for limiting resources.' SUP top STRUCTURAL X-ORIGIN 'user defined' )
objectClasses: ( 1.3.18.0.2.6.119 NAME 'eNTUser' DESC 'Contains NT specific attributes that are modifiable by the user.' SUP eUser STRUCTURAL MUST ( ntDomainUserID $ uid ) MAY ( eNTPasswordSync $ secretKey ) X-ORIGIN 'user defined' )
objectClasses: ( 1.3.18.0.2.6.27 NAME 'eGSOuser' DESC 'Contains GSO user-specfic information.' SUP eUser STRUCTURAL MUST ( cn $ userState $ userType ) MAY ( associatedName $ subadminGroup $ targetGroup ) X-ORIGIN 'user defined' )
objectClasses: ( 1.3.18.0.2.6.73 NAME 'ePerson' DESC 'Includes definitions not already part of inetOrgPerson.' SUP top AUXILIARY MAY ( accessHint $ accountHint $ audio $ businessCategory $ c $ carLicense $ configPtr $ departmentNumber $ description $ destinationIndicator $ displayName $ employeeNumber $ employeeType $ facsimileTelephoneNumber $ generationQualifier $ givenName $ homeFax $ homePhone $ homePostalAddress $ initials $ internationaliSDNNumber $ jpegPhoto $ l $ labeledUri $ mail $ manager $ middleName $ mobile $ o $ organizationalStatus $ otherMailbox $ ou $ pager $ personalTitle $ photo $ physicalDeliveryOfficeName $ postalAddress $ postalCode $ postOfficeBox $ preferredDeliveryMethod $ preferredLanguage $ registeredAddress $ roomNumber $ secretary $ seeAlso $ st $ street $ telephoneNumber $ teletexTerminalIdentifier $ telexNumber $ thumbNailLogo $ thumbNailPhoto $ title $ uid $ uniqueIdentifier $ userCertificate $ userPassword $ userPKCS12 $ userSMIMECertificate $ x121Address $ x500UniqueIdentifier ) X-ORIGIN 'user defined' )
objectClasses: ( 1.3.18.0.2.6.32 NAME 'eTargetServiceType' DESC 'GSO Target Service Type.' SUP top STRUCTURAL MUST tsType MAY ( authenticationType $ capability $ caption $ description $ msgFileName $ optIdentifierName $ reqIdentifierName ) X-ORIGIN 'user defined' )
objectClasses: ( 1.3.18.0.2.6.475 NAME 'ibm-appUUIDAux' DESC 'Auxiliary class for unique static not-reused entry identifier.' SUP top AUXILIARY MAY ibm-appUUID X-ORIGIN 'user defined' )
objectClasses: ( 1.3.6.1.4.1.1466.154.151.160.1 NAME 'liPerson' DESC 'This Network Application Consortium defined structural class may be used to represent people and contains many commonly used organizational and residential attributes.' SUP person STRUCTURAL MAY ( c $ facsimileTelephoneNumber $ generationQualifier $ givenName $ homeFax $ homePhone $ homePostalAddress $ initials $ l $ labeledUri $ mail $ manager $ middleName $ mobile $ o $ otherMailbox $ ou $ pager $ personalTitle $ postalAddress $ roomNumber $ secretary $ telexNumber $ thumbNailLogo $ thumbNailPhoto $ title $ uniqueIdentifier $ userCertificate ) X-ORIGIN 'user defined' )
objectClasses: ( 1.3.6.1.4.1.1466.154.151.160.2 NAME 'liOrganization' DESC 'This structural class defines lightweight internet organizations; defined by Network Applications  Consortium and The Open Group.' SUP organization STRUCTURAL MAY ( c $ labeledUri $ mail $ manager $ otherMailbox $ thumbNailLogo $ uniqueIdentifier ) X-ORIGIN 'user defined' )
objectClasses: ( 1.3.6.1.4.1.4228.1.10 NAME 'secMap' DESC 'Security Mapping ofUUID <-> DN' SUP Top STRUCTURAL MUST ( secDN $ secUUID ) X-ORIGIN 'user defined' )
objectClasses: ( 1.3.6.1.4.1.4228.1.17 NAME 'secPolicy' DESC 'Security Policyinformation for password and account missing from' SUP ePasswordPolicy STRUCTURAL MAY ( secAcctExpires $ secAcctInactivity $ secAcctLife $ secPwdAlpha $ secPwdSpaces $ secPwdMgmtBind $ secTODAccess $ secMaxWebSessions $ secPwdFailureCountInterval ) X-ORIGIN 'user defined' )
objectClasses: ( 1.3.6.1.4.1.4228.1.21 NAME 'secPolicyData' DESC 'Security Policy dynamic data' SUP Top STRUCTURAL MUST cn MAY ( secPwdFailures $ secPwdLastChanged $ secPwdLastUsed $ secPwdList ) X-ORIGIN 'user defined' )
objectClasses: ( 1.3.6.1.4.1.4228.1.304 NAME 'secResource' DESC 'Resource registry object.' SUP Top STRUCTURAL MUST ( secResourceID $ secType ) MAY ( description $ secUUID $ secValid ) X-ORIGIN 'user defined' )
objectClasses: ( 1.3.6.1.4.1.4228.1.305 NAME 'secResGroup' DESC 'Resource Group registry object.' SUP Top STRUCTURAL MUST ( secResGroupID $ secType ) MAY ( description $ secUUID $ secValid $ member ) X-ORIGIN 'user defined' )
objectClasses: ( 1.3.6.1.4.1.4228.1.306 NAME 'secResCreds' DESC 'Resource Credential registry object.' SUP Top STRUCTURAL MUST ( secResCredsID $ secType ) MAY ( description $ secUUID $ secValid $ secUid $ secAuthnLength $ secAuthnType $ secAuthnData ) X-ORIGIN 'user defined' )
objectClasses: ( 1.3.6.1.4.1.4228.1.6 NAME 'secUser' DESC 'Policy Director ePerson authentication information' SUP eUser STRUCTURAL MUST ( secAuthority $ secLoginType ) MAY ( secPwdFailures $ secAcctValid $ secPwdValid $ secCertDN $ secCertSerialNumber $ secUUID $ secPwdLastChanged $ secPwdLastUsed $ secHasPolicy $ secDN $ secHomeGroup $ secDomainId $ secPwdLastFailed $ secPwdFailCountTime $ secPwdUnlockTime $ secSelfAlias $ secPartnerAlias $ secOtherAlias ) X-ORIGIN 'user defined' )
objectClasses: ( 1.3.6.1.4.1.4228.1.7 NAME 'secGroup' DESC 'Security group information' SUP top STRUCTURAL MUST ( secAuthority $ cn ) MAY ( secUUID $ secHasPolicy $ secDN ) X-ORIGIN 'user defined' )
objectClasses: ( 1.3.6.1.4.1.4228.1.8 NAME 'secAuthorityInfo' DESC 'Security Authority Information' SUP eApplicationSystem STRUCTURAL MUST ( secAuthority $ version ) X-ORIGIN 'user defined' )
objectClasses: ( 1.3.6.1.4.1.7611.0.1.2111 NAME 'FRITServiceUnit' DESC 'A service unit definition' SUP top STRUCTURAL MUST ( FRITServiceUnit $ FRITServiceUnitDescription ) MAY FRITInactiveFlag X-ORIGIN 'user defined' )
objectClasses: ( 1.3.6.1.4.1.7611.0.1.2112 NAME 'FRITABAOrganization' DESC 'An organization represented by an ABA number' SUP top STRUCTURAL MUST FRITABA MAY FRITABAName X-ORIGIN 'user defined' )
objectClasses: ( 1.3.6.1.4.1.7611.19.0.1 NAME 'FRFedLineOrgPerson' DESC 'FR FedLine organizational person' SUP inetorgperson STRUCTURAL MAY ( FRFedLineDID $ FRFedLineDUID ) X-ORIGIN 'user defined' )
objectClasses: ( 1.3.6.1.4.1.7611.99.0.0 NAME 'FRSysOrgPerson' SUP inetorgperson STRUCTURAL MAY ( FRSysEntID $ frsysgwdisplayname $ frsysgwdn $ FRSysHrDeptDesc $ FRSysHrEmpStat $ FRSysHrFlsaStat $ FRSysHrFullPart $ FRSysHrHireDt $ FRSysHrJobCodeDesc $ FRSysHrLoc $ FRSysHrMgrLevel $ FRSysHrNamePrefix $ FRSysHrOffCd $ FRSysHrPayGrp $ FRSysHrPerfFirstName $ FRSysHrPerStat $ FRSysHrPerType $ FRSysHrRegTemp $ FRSysHrRehireDt $ FRSysHrShift $ FRSysHrSupervisor $ FRSysHrTerminationDt $ FRSysMfLIDName $ FRSysNosUPN $ FRSysUUID $ nsRoleDN ) X-ORIGIN 'user defined' )
objectClasses: ( 1.3.6.1.4.1.7611.99.0.100 NAME 'FRSysCert' SUP top AUXILIARY MUST ( FRSysCertKeyUsage $ FRSysCertNotAfter $ FRSysCertNotBefore $ FRSysCertSerialNumber ) MAY ( FRSysCertCRLDPURI $ FRSysCertExtKeyUsage $ FRSysCertRFC822Name $ FRSysCertSubjectOtherName ) X-ORIGIN 'user defined' )
objectClasses: ( 1.3.6.1.4.1.7611.99.0.120 NAME 'FRSysRFC822' SUP top STRUCTURAL MAY FRSysRFC822Email X-ORIGIN 'user defined' )
objectClasses: ( 1.3.6.1.4.1.7611.99.0.200 NAME 'FRSysTreasPerson' DESC 'Class used for Treasury Users' SUP top AUXILIARY MAY FRSysTreasAltDN X-ORIGIN 'user defined' )
objectClasses: ( 2.5.6.21 NAME 'pkiUser' DESC 'Used to represent certificate subjects.' SUP top AUXILIARY MAY userCertificate X-ORIGIN 'user defined' )
objectClasses: ( 2.5.6.22 NAME 'pkiCA' DESC 'Represents a Certification Authority.' SUP top AUXILIARY MAY ( authorityRevocationList $ cACertificate $ certificateRevocationList $ crossCertificatePair ) X-ORIGIN 'user defined' )
objectClasses: ( 2.5.6.23 NAME 'deltaCRL' DESC 'PKIX Delta Certificate Revocation List' SUP top AUXILIARY MAY deltaRevocationList X-ORIGIN 'user defined')
objectClasses: ( 2.5.6.24 NAME 'pmiUser' DESC 'pmiUser for Entrust/PKI 5.1' SUP top AUXILIARY MAY attributeCertificate X-ORIGIN 'user defined' )
objectClasses: ( 2.16.840.1.114027.21.2 NAME 'bipUser' SUP top STRUCTURAL MAY bipPrintLocation X-ORIGIN 'user defined' )
objectClasses: ( application-oid NAME 'application' SUP top STRUCTURAL MUST cn MAY description X-ORIGIN 'user defined' )
objectClasses: ( component-oid NAME 'component' SUP top STRUCTURAL MAY description X-ORIGIN 'user defined' )
objectClasses: ( envtype-oid NAME 'envtype' SUP top STRUCTURAL MUST ( c $ cn ) MAY description X-ORIGIN 'user defined' )
objectClasses: ( oldQualityLabelledData-oid NAME 'oldQualityLabelledData' DESC '  ' SUP top STRUCTURAL MUST singleLevelQuality MAY ( subtreeMaximumQuality $ subtreeMinimumQuality ) X-ORIGIN 'user defined' )
objectClasses: ( userrole-oid NAME 'userrole' SUP groupofuniquenames STRUCTURAL X-ORIGIN 'user defined' )
objectClasses: ( 1.3.18.0.2.6.33  NAME 'eTargetService'  DESC '  '  SUP top  Structural  MUST ( tsName $ tsType )  MAY ( caption $ description $ authenticationType $ reqIdentifier $ optIdentifier ) )
objectClasses: ( 1.3.6.1.4.1.7611.99.0.130 NAME 'FRSysMonitor' SUP top AUXILIARY MAY inetDomainStatus X-ORIGIN 'user defined' )
objectClasses: ( 1.3.18.0.2.6.41 NAME 'eGSODomain' DESC '  ' SUP top Structural MUST ( cn ) MAY ( caption $ description $ targetLocation ) )
objectClasses: ( 1.3.18.0.2.6.131 NAME 'cimSetting' DESC ' ' SUP cimManagedElement Abstract MAY ( settingID ) )
objectClasses: ( 1.3.18.0.2.6.29 NAME 'eTargetRecord' DESC '  ' SUP cimSetting Structural MUST ( cn ) MAY ( principalName $ tsType $ accountService $ targetService $ targetAdapter $ reqIdentifier $ optIdentifier $ passwordGenerator $ launchable $ prereqTarget $ autoInitiate $ autoTerminate $ secretKey ) )
objectClasses: ( 1.3.6.1.4.1.7611.99.0.300 NAME 'FRSysFRITPerson' SUP top AUXILIARY MAY ( c $ FRITABA $ FRITAcf2Id $ FRITAddress2 $ FRITApprover $ FRITApproverEmail $ FRITApproverPhone $ FRITBSRAgency $ FRITCertRefNum $ FRITCredType $ FRITDistrictName $ FRITDistrictOfficeLocationName $ FRITExtServices $ FRITIntServices $ FRITMailType $ FRITMngABA $ FRITMngServices $ FRITParentDomain $ FRITServiceUnit $ FRITUserRole $ FRSysLastSuccessfulLogindate $ FRITIAMEnv $ FRITCredRisk $ FRITCredEnv $ FRITRSSDID $ FRITGLNID $ FRITLEID $ middleName ) X-ORIGIN 'user defined' )
