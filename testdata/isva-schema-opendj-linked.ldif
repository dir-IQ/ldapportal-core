# SPDX-License-Identifier: Apache-2.0
# IVIA test-fixture ISVA/ISAM schema — OpenDJ (OUD substitute) form.
# LINKED-mode variant: secUser is STRUCTURAL, matching how IBM ships it.
# In linked topology every secUser is its own standalone entry under the
# management DIT (RDN secUUID=..., back-referencing the demographic via
# secDN), so it must supply its own structural class — which the app's
# linked-grant writes as `objectClass: top` + `objectClass: secUser` and
# nothing else. For INLINE mode — where secUser overlays onto an existing
# demographic person entry that already has a structural class — use the
# sibling testdata/isva-schema-opendj-inline.ldif (secUser AUXILIARY).
# An entry may hold only one structural class, so the two modes cannot
# share a single secUser definition; that is why this fixture is split.
#
# Fixture simplification vs. real IBM: IBM's secUser is `SUP eUser`
# STRUCTURAL MUST ( secAuthority $ secLoginType ). This fixture keeps the
# `SUP eUser` superior chain — essential, because configs that list both
# secUser and eUser (e.g. to name entries on eUser's principalName) then
# put both classes on ONE structural chain; with an unrelated `SUP top`
# secUser the server rejects every such ADD with "multiple conflicting
# structural objectclasses". It defines secLoginType (which the app now
# writes on every grant, alongside secAuthority) but keeps both as MAY
# rather than MUST, so the pre-existing fixture entries below — which
# predate secLoginType and omit it — still load. The app keys on the
# secUser objectClass NAME + the secDN back-reference, not on OIDs.
#
# Same attribute set as the inline variant and as
# testdata/isva-schema-openldap.ldif, expressed in OpenDJ's native
# subschema-entry format (the form config/schema/*.ldif files take).
# Mounted into the oud1 fixtures at /opt/opendj/bootstrap/config/schema/ —
# the image copies that directory into the instance's template/config/schema
# *before* setup, so the schema is present from first boot. (The image's
# other bootstrap dir, /opt/opendj/bootstrap/schema/, runs files through
# ldapmodify after setup and needs changetype:modify LDIF — not this form.)
#
# Private-arc OIDs (1.3.6.1.4.1.99999.*) — fixture only, not IBM's
# registered OIDs. The app keys on attribute/objectClass NAMES, not OIDs.
#
# The IBM eUser / cimManagedElement object classes come from IBM's
# published directory schema and keep IBM's real registered OIDs
# (1.3.18.0.2.*) rather than the private-arc fixture OIDs above. They
# reference the standard `description` and `userCertificate` attributes,
# which already exist in OpenDJ's core schema. They are defined BEFORE
# secUser so secUser's `SUP eUser` reference resolves in file order.
#
# Manual fallback (if the schema wasn't auto-imported): copy this file
# into the running instance's schema dir — which lives under the data
# volume at /opt/opendj/data/config/schema (NOT /opt/opendj/config/schema)
# — and restart, e.g.
#   docker cp testdata/isva-schema-opendj-linked.ldif \
#     ldap-oud1-primary:/opt/opendj/data/config/schema/99-isva.ldif
#   docker restart ldap-oud1-primary
# (OpenDJ reads every config/schema/*.ldif at boot.) Or apply live with
# ldapmodify against cn=schema using the changetype:modify variant.

dn: cn=schema
objectClass: top
objectClass: ldapSubentry
objectClass: subschema
attributeTypes: ( 1.3.6.1.4.1.99999.1.1.1 NAME 'secLogin' DESC 'IVIA test fixture: login name within secAuthority' EQUALITY caseIgnoreMatch SUBSTR caseIgnoreSubstringsMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{255} SINGLE-VALUE X-ORIGIN 'IVIA test fixture' )
attributeTypes: ( 1.3.6.1.4.1.99999.1.1.2 NAME 'secAuthority' DESC 'IVIA test fixture: authority / policy domain' EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{255} SINGLE-VALUE X-ORIGIN 'IVIA test fixture' )
attributeTypes: ( 1.3.6.1.4.1.99999.1.1.3 NAME 'secAcctValid' DESC 'IVIA test fixture: TRUE when the account is valid' EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{5} SINGLE-VALUE X-ORIGIN 'IVIA test fixture' )
attributeTypes: ( 1.3.6.1.4.1.99999.1.1.4 NAME 'secPwdValid' DESC 'IVIA test fixture: TRUE when the password is valid' EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{5} SINGLE-VALUE X-ORIGIN 'IVIA test fixture' )
attributeTypes: ( 1.3.6.1.4.1.99999.1.1.5 NAME 'secValidUntil' DESC 'IVIA test fixture: generalized time the account ceases to be valid' EQUALITY generalizedTimeMatch ORDERING generalizedTimeOrderingMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.24 SINGLE-VALUE X-ORIGIN 'IVIA test fixture' )
attributeTypes: ( 1.3.6.1.4.1.99999.1.1.6 NAME 'secPwdLastChanged' DESC 'IVIA test fixture: generalized time the password was last changed' EQUALITY generalizedTimeMatch ORDERING generalizedTimeOrderingMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.24 SINGLE-VALUE X-ORIGIN 'IVIA test fixture' )
attributeTypes: ( 1.3.6.1.4.1.99999.1.1.7 NAME 'secDN' DESC 'IVIA test fixture: back-reference DN of the paired demographic (linked mode)' EQUALITY distinguishedNameMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.12 SINGLE-VALUE X-ORIGIN 'IVIA test fixture' )
attributeTypes: ( 1.3.6.1.4.1.99999.1.1.8 NAME 'secUUID' DESC 'IVIA test fixture: opaque identifier for the secUser entry' EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{255} SINGLE-VALUE X-ORIGIN 'IVIA test fixture' )
attributeTypes: ( 1.3.6.1.4.1.99999.1.1.9 NAME 'secLoginType' DESC 'IVIA test fixture: login type (MUST on IBM stock secUser)' EQUALITY caseIgnoreMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15{255} SINGLE-VALUE X-ORIGIN 'IVIA test fixture' )
attributeTypes: ( 1.3.18.0.2.4.483 NAME 'caption' DESC 'CIM-derived attributeto provide short description of the directory object entry for display purposes.' EQUALITY 2.5.13.2 SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE X-ORIGIN 'user defined' )
attributeTypes: ( 1.3.18.0.2.4.292 NAME 'accessHint' DESC 'DN pointer to an accessRole or accessGroup.' SYNTAX 1.3.6.1.4.1.1466.115.121.1.12 X-ORIGIN 'user defined' )
attributeTypes: ( 1.3.18.0.2.4.293 NAME 'accountHint' DESC 'DN pointer to an account directory object.' SYNTAX 1.3.6.1.4.1.1466.115.121.1.12 X-ORIGIN 'user defined' )
attributeTypes: ( 1.3.18.0.2.4.312 NAME 'configPtr' DESC 'DN pointer to a cimConfiguration-derived directory entry such as an ePropertySet.' SYNTAX 1.3.6.1.4.1.1466.115.121.1.12 X-ORIGIN 'user defined' )
attributeTypes: ( 1.3.18.0.2.4.318 NAME ( 'principalName' 'principal' ) DESC 'A naming attribute that may be used to identify eUser object entries.' SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 X-ORIGIN 'user defined' )
objectClasses: ( 1.3.18.0.2.6.132 NAME 'cimManagedElement' DESC 'Based on the proposed CIM_ManagedElement object class, cimManagedElement  provides a basis for many of the system management object classes in the  IBM schema.' SUP top ABSTRACT MAY ( caption $ description ) X-ORIGIN 'user defined' )
objectClasses: ( 1.3.18.0.2.6.79 NAME 'eUser' DESC 'Based on the proposed CIM_Principal object class, the eUser object class is used to represent a persons (or service\27s or SAPs) relationship to a system or set of systems.  It can be used to provide a description for a certificate, to select from amonga set of user profiles, or sets of functions and roles.' SUP cimManagedElement STRUCTURAL MAY ( accessHint $ accountHint $ configPtr $ principalName $ userCertificate ) X-ORIGIN 'user defined' )
objectClasses: ( 1.3.6.1.4.1.99999.1.2.1 NAME 'secUser' DESC 'IVIA test fixture: standalone secUser entry (STRUCTURAL SUP eUser, as IBM ships it; the inline variant makes this AUXILIARY). secLoginType/secAuthority are MUST on IBM stock secUser; kept MAY here so pre-existing fixture entries load.' SUP eUser STRUCTURAL MAY ( secLogin $ secLoginType $ secAuthority $ secAcctValid $ secPwdValid $ secValidUntil $ secPwdLastChanged $ secDN $ secUUID ) X-ORIGIN 'IVIA test fixture' )
objectClasses: ( 1.3.6.1.4.1.99999.1.2.2 NAME 'secAuthorityInfo' DESC 'IVIA test fixture: structural class for the management-DIT base entry whose RDN is secAuthority=...' SUP top STRUCTURAL MUST ( secAuthority ) X-ORIGIN 'IVIA test fixture' )
objectClasses: ( 1.3.6.1.4.1.99999.1.2.3 NAME 'secGroup' DESC 'IVIA test fixture: ISVA group overlay (AUXILIARY so it layers onto groupOfNames / groupOfUniqueNames; the app and the require-secGroup gate key on the NAME only)' SUP top AUXILIARY MAY ( secAuthority $ secUUID ) X-ORIGIN 'IVIA test fixture' )
