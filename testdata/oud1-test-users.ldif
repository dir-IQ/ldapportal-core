# =============================================================================
# oud1-test-users.ldif — 100 inetOrgPerson test users for the oud1 directory.
#
# Base DN:  dc=oud1,dc=example,dc=com   (OUD / OpenDJ; auto-created by the container at init)
# Loads into: ou=People,dc=oud1,dc=example,dc=com
#
# Composition: 100 users, evenly split across 5 departments (20 each:
# Engineering, Sales, Marketing, HumanResources, Finance). 10 of them are
# department managers (title "<Dept> Manager"). Names are deterministic
# (10 given x 10 surnames = 100 unique uid/mail).
#
# Convention (matches testdata/oud-bootstrap.ldif): each user's
# userPassword is their uid (e.g. alice.anderson -> alice.anderson).
# Scramble before exposing anywhere non-local.
#
# The suffix root entry (dc=oud1,dc=example,dc=com) is intentionally NOT included — the
# OpenDJ entrypoint creates it from BASE_DN before the import runs;
# re-adding it returns code 68 (Already exists) and aborts the import.
#
# Load (then load oud1-test-groups.ldif afterwards):
#   ldapadd -c -x -H ldap://localhost:3389 \
#     -D "cn=Directory Manager" -w <password> -f testdata/oud1-test-users.ldif
# =============================================================================

dn: ou=People,dc=oud1,dc=example,dc=com
objectClass: top
objectClass: organizationalUnit
ou: People
description: Test user accounts for the oud1 directory

