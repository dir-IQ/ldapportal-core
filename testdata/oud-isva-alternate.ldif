# SPDX-License-Identifier: Apache-2.0
# =============================================================================
# LDIF Test Data — ISVA/IVIA account anomalies + replication divergence
#   ALTERNATE side — load into the `oud1-alternate` fixture.  LINKED TOPOLOGY.
#
# Base DN : dc=oud1,dc=example,dc=com   (same suffix as the primary; the two
#           instances are INDEPENDENT and do not replicate — divergence is
#           simulated by loading this near-copy with deliberate differences).
# Schema  : secUser (AUXILIARY) + secAuthorityInfo (STRUCTURAL), auto-loaded.
#
# Load (from repo root):
#   docker exec -i ldap-oud1-alternate /opt/opendj/bin/ldapmodify \
#     -h localhost -p 1389 -D 'cn=Directory Manager' -w admin \
#     -a < testdata/oud-isva-alternate.ldif
#
# Sibling of oud-isva-primary.ldif (LINKED topology: demographic under
# ou=people + paired secUser under secAuthority=Default,ou=management, joined
# by secDN). Most entries match the primary verbatim; the DIVERGENCE markers
# (R1–R7) below are the only intentional differences and are the substance of
# the replication-issue test surface. The shared anomalies (orphan /
# pwd-invalid / stale-pwd / partial / expiring-soon / dangling secUser) are
# duplicated here unchanged so each instance is independently valid as an
# anomaly dataset. See testdata/README-oud-isva-anomalies.md for the matrix.
#
# Reference "now" = 2026-06-02. userPassword == uid (local dev only).
# =============================================================================

# ── Containers ───────────────────────────────────────────────────────────────
dn: ou=people,dc=oud1,dc=example,dc=com
objectClass: top
objectClass: organizationalUnit
ou: people

dn: ou=groups,dc=oud1,dc=example,dc=com
objectClass: top
objectClass: organizationalUnit
ou: groups

dn: ou=management,dc=oud1,dc=example,dc=com
objectClass: top
objectClass: organizationalUnit
ou: management

dn: secAuthority=Default,ou=management,dc=oud1,dc=example,dc=com
objectClass: top
objectClass: secAuthorityInfo
secAuthority: Default

# =============================================================================
# DEMOGRAPHIC ENTRIES  (ou=people — plain inetOrgPerson, no secUser overlay)
# =============================================================================

# ── alice.normal — DIVERGENCE R3: ATTRIBUTE CONFLICT. ───────────────────────
# Same DN as the primary, but mail + title hold stale values → a conflicting
# demographic modify that never converged.
dn: uid=alice.normal,ou=people,dc=oud1,dc=example,dc=com
objectClass: top
objectClass: person
objectClass: organizationalPerson
objectClass: inetOrgPerson
uid: alice.normal
cn: Alice Normal
sn: Normal
givenName: Alice
mail: alice.normal@old.example.com
title: Engineer
userPassword: alice.normal

# ── bob.orphan — ORPHANED (linked). Identical to primary (no paired secUser). ─
dn: uid=bob.orphan,ou=people,dc=oud1,dc=example,dc=com
objectClass: top
objectClass: person
objectClass: organizationalPerson
objectClass: inetOrgPerson
uid: bob.orphan
cn: Bob Orphan
sn: Orphan
givenName: Bob
mail: bob.orphan@oud1.example.com
userPassword: bob.orphan

# ── carol.suspended — demographic identical; see R4 on her secUser below. ───
dn: uid=carol.suspended,ou=people,dc=oud1,dc=example,dc=com
objectClass: top
objectClass: person
objectClass: organizationalPerson
objectClass: inetOrgPerson
uid: carol.suspended
cn: Carol Suspended
sn: Suspended
givenName: Carol
mail: carol.suspended@oud1.example.com
userPassword: carol.suspended

