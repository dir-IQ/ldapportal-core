<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.ldapportal</groupId>
    <artifactId>ldapportal-parent</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>ldapportal-parent</name>
    <description>
        Parent POM for the ldapportal project. Two library modules (core, ee)
        and one distribution that assembles the runnable Spring Boot JAR.
        See docs/refactor-plan.md Phase 5 for the module boundary rationale.
    </description>

    <!-- Maven Central publishing metadata, shared by every published module
         (core and the open-source addons). Inert for normal/CI builds; the
         `release` profile below consumes it, and flatten (flattenMode=ossrh)
         inlines it into each module's self-contained published POM. The parent
         itself is never published — it's the aggregator. -->
    <!-- The <scm> inherit.append.path="false" attributes keep the clone
         connection/url verbatim in every child (a module-path append would
         break `git clone`). The project <url> takes Maven's default child
         append (…/<module>); harmless and Central-valid, so left as-is. -->
    <url>https://github.com/dir-IQ/ldapportal-core</url>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <name>Sanjay Mishra</name>
            <email>mishra.sanjayk@gmail.com</email>
            <organization>dir-IQ</organization>
            <organizationUrl>https://github.com/dir-IQ</organizationUrl>
        </developer>
    </developers>
    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <connection>scm:git:https://github.com/dir-IQ/ldapportal-core.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/dir-IQ/ldapportal-core.git</developerConnection>
        <url>https://github.com/dir-IQ/ldapportal-core</url>
    </scm>

    <modules>
        <module>core</module>
        <!--
            addons/* — open-source optional modules (Apache 2.0). The
            namespace is created in P0 of the ISVA full-mode plan;
            individual addon modules uncomment their entry below as
            they land.
        -->
        <module>addons/isva</module>
        <module>distribution/community</module>
        <module>distribution/community-plus-isva</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <jjwt.version>0.13.0</jjwt.version>
        <logstash-logback.version>7.4</logstash-logback.version>
        <springdoc.version>2.8.17</springdoc.version>
        <unboundid-ldapsdk.version>7.0.5</unboundid-ldapsdk.version>
        <lombok.version>1.18.46</lombok.version>
        <openpdf.version>2.4.0</openpdf.version>
        <archunit.version>1.4.2</archunit.version>
        <!-- Override Spring Boot BOM's pgjdbc 42.7.10 → 42.7.11 to clear
             CVE-2026-42198 (pgjdbc client-side DoS via malicious
             SCRAM-SHA-256 auth response). Trivy was failing the
             backend image scan on this. Drop this override when the
             Spring Boot BOM bumps past 42.7.11. -->
        <postgresql.version>42.7.11</postgresql.version>
        <!-- Override Spring Boot BOM's Tomcat 10.1.54 → 10.1.55 to clear
             six HIGH/CRITICAL Trivy findings on the backend image:
               CVE-2026-41293, CVE-2026-43512, CVE-2026-43515 (CRITICAL)
               CVE-2026-41284, CVE-2026-42498, CVE-2026-43513 (HIGH)
             All six are fixed in 10.1.55. Drop this override when the
             Spring Boot BOM bumps past 10.1.55. -->
        <tomcat.version>10.1.55</tomcat.version>
        <!-- Override Spring Boot BOM's Jackson → 2.21.5 to clear CVE-2026-54515
             (jackson-databind re-exposes @JsonIgnoreProperties-ignored fields
             when @JsonFormat(ACCEPT_CASE_INSENSITIVE_PROPERTIES) is set, because
             the case-insensitivity rebuild restores the unfiltered property map).
             The 2.19.x line's only fix is 2.21.5. Drop this override when the
             Spring Boot BOM bumps past 2.21.5. -->
        <jackson-bom.version>2.21.5</jackson-bom.version>
        <!-- Override Spring Boot BOM's commons-lang3 → 3.18.0 to clear
             CVE-2025-48924 (uncontrolled recursion: ClassUtils.getClass can
             throw StackOverflowError on very long inputs). Drop this override
             when the Spring Boot BOM bumps past 3.18.0. -->
        <commons-lang3.version>3.18.0</commons-lang3.version>
        <!-- Override Spring Boot BOM's logback → 1.5.34 to clear CVE-2026-10532
             (HardenedObjectInputStream object-injection via logback-core's
             SimpleSocketServer/SimpleSSLSocketServer receivers — not reachable
             in this app, but clears the image scan). Drop this override when the
             Spring Boot BOM bumps past 1.5.34. -->
        <logback.version>1.5.34</logback.version>
        <!-- Override byte-buddy + mockito for Java 25 compatibility -->
        <byte-buddy.version>1.18.7</byte-buddy.version>
        <mockito.version>5.23.0</mockito.version>
        <jacoco.version>0.8.15</jacoco.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
        <!-- Default for the coverage agent -vmargs slot in surefire's argLine.
             JaCoCo's prepare-agent overwrites this at build time; the empty
             default keeps `mvn test -Djacoco.skip=true` (and IDE runs that
             don't execute the plugin) working. -->
        <jacocoArgLine></jacocoArgLine>
    </properties>

    <!--
        Centralised dependency versions. Leaf modules declare which
        dependencies they actually pull in, but the version is defined
        exactly once — here — so core and ee can't drift.
    -->
    <dependencyManagement>
        <dependencies>
            <!-- ldapportal internal modules -->
            <dependency>
                <groupId>com.ldapportal</groupId>
                <artifactId>ldapportal-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ldapportal</groupId>
                <artifactId>ldapportal-core</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
            </dependency>
            <dependency>
                <groupId>com.ldapportal</groupId>
                <artifactId>ldapportal-ee</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ldapportal</groupId>
                <artifactId>ldapportal-addons-isva</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Third-party deps whose versions aren't managed by spring-boot-starter-parent -->
            <dependency>
                <groupId>com.unboundid</groupId>
                <artifactId>unboundid-ldapsdk</artifactId>
                <version>${unboundid-ldapsdk.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.librepdf</groupId>
                <artifactId>openpdf</artifactId>
                <version>${openpdf.version}</version>
            </dependency>
            <dependency>
                <groupId>net.logstash.logback</groupId>
                <artifactId>logstash-logback-encoder</artifactId>
                <version>${logstash-logback.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Surefire: JVM args for Java 22+ module access (Mockito byte-buddy).
                     @{jacocoArgLine} is late-bound so the JaCoCo agent (set by
                     prepare-agent below) attaches to test JVMs. -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <argLine>
                            @{jacocoArgLine}
                            --add-opens java.base/java.lang=ALL-UNNAMED
                            --add-opens java.base/java.lang.reflect=ALL-UNNAMED
                            --add-opens java.base/java.util=ALL-UNNAMED
                        </argLine>
                    </configuration>
                </plugin>
                <!-- Coverage: agent attaches via @{jacocoArgLine} in surefire's
                     argLine; the XML/HTML report lands in target/site/jacoco of
                     each module after `mvn test`. Report-only — no coverage
                     floor yet; ratchet one in once a baseline is agreed. -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                    <executions>
                        <execution>
                            <id>prepare-agent</id>
                            <goals><goal>prepare-agent</goal></goals>
                            <configuration>
                                <propertyName>jacocoArgLine</propertyName>
                            </configuration>
                        </execution>
                        <execution>
                            <id>report</id>
                            <phase>test</phase>
                            <goals><goal>report</goal></goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven-enforcer-plugin.version}</version>
                    <executions>
                        <execution>
                            <id>enforce-build-environment</id>
                            <goals><goal>enforce</goal></goals>
                            <configuration>
                                <rules>
                                    <requireMavenVersion>
                                        <!-- Match .mvn/wrapper (3.9.9) and the
                                             maven:3.9 Docker build stage. -->
                                        <version>[3.9,)</version>
                                    </requireMavenVersion>
                                    <requireJavaVersion>
                                        <version>[21,)</version>
                                    </requireJavaVersion>
                                    <banDuplicatePomDependencyVersions/>
                                    <dependencyConvergence/>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <!-- JDK 23+ no longer runs annotation processors by default -->
                        <proc>full</proc>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.springframework.boot</groupId>
                                <artifactId>spring-boot-configuration-processor</artifactId>
                                <!-- spring-boot.version is defined by spring-boot-starter-parent.
                                     Pre-split this was ${project.parent.version} since
                                     spring-boot-starter-parent was the direct parent; after
                                     the multi-module split our own parent POM is, so we
                                     reference Spring Boot's version by property name instead. -->
                                <version>${spring-boot.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                        <!-- Surface the git short-SHA in the runtime build-info
                             so the version endpoint can echo it back and
                             deployment skew is debuggable at a glance.
                             git.commit.id.abbrev is set by the
                             git-commit-id-maven-plugin execution below. -->
                        <additionalProperties>
                            <git.sha>${git.commit.id.abbrev}</git.sha>
                        </additionalProperties>
                    </configuration>
                </plugin>
                <!-- Resolves git.commit.id.abbrev from the working-copy HEAD so
                     the spring-boot-maven-plugin's build-info goal can write it
                     into META-INF/build-info.properties. failOnNoGitDirectory
                     is false so non-git checkouts (release tarballs, CI
                     workspaces that strip .git) still build — they just won't
                     have a SHA to surface. -->
                <plugin>
                    <groupId>io.github.git-commit-id</groupId>
                    <artifactId>git-commit-id-maven-plugin</artifactId>
                    <version>9.2.0</version>
                    <executions>
                        <execution>
                            <id>get-the-git-infos</id>
                            <goals><goal>revision</goal></goals>
                            <phase>initialize</phase>
                        </execution>
                    </executions>
                    <configuration>
                        <failOnNoGitDirectory>false</failOnNoGitDirectory>
                        <failOnUnableToExtractRepoInfo>false</failOnUnableToExtractRepoInfo>
                        <abbrevLength>7</abbrevLength>
                        <generateGitPropertiesFile>false</generateGitPropertiesFile>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- Bind coverage + build-environment enforcement in every module;
                 full configuration lives in pluginManagement above. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Maven Central release profile (Phase 5b). Activated only with
            `-Prelease`, so dev/CI/reactor builds are entirely unaffected and
            need no GPG key. Lives in the parent so every published module —
            core and the open-source addons (addons/isva) — inherits the same
            flatten + sign + central-publishing machinery without copying it.
            Run from the release workflow, which scopes the deploy to the
            publishable modules:

              ./mvnw -Prelease -DskipTests -pl core,addons/isva deploy

            The `-pl` scoping is what keeps the never-published assembly
            modules (distribution/*) and the aggregator parent out of the
            upload; do not run `-Prelease deploy` over the full reactor.

            - flatten: published modules inherit the aggregator ldapportal-parent,
              which is NOT published. flatten resolves the parent and emits a
              self-contained POM (flattenMode=ossrh keeps the name/description/
              url/scm/licenses/developers Central requires).
            - source + javadoc jars: required by Central.
            - gpg: signs all artifacts (key supplied via env in CI).
            - central-publishing-maven-plugin: uploads to the Central Portal;
              autoPublish=false leaves the deployment in a droppable staging
              state for a dry-run before manual release.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>flatten-maven-plugin</artifactId>
                        <version>1.7.3</version>
                        <configuration>
                            <flattenMode>ossrh</flattenMode>
                        </configuration>
                        <executions>
                            <execution>
                                <id>flatten</id>
                                <phase>process-resources</phase>
                                <goals><goal>flatten</goal></goals>
                            </execution>
                            <execution>
                                <id>flatten-clean</id>
                                <phase>clean</phase>
                                <goals><goal>clean</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <configuration>
                            <!-- Don't let strict doclint or a single bad
                                 @link fail a release; publishing the jar
                                 matters more than pristine javadoc. -->
                            <doclint>none</doclint>
                            <failOnError>false</failOnError>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            Interim cross-repo publishing to GitHub Packages. Activated with
            `-Pinternal-publish`. This is the inner-loop counterpart to `release`:
            it shares pre-release builds of core + the open-source addons with
            downstream repos (the commercial/ee build) BEFORE a formal Central
            release, so ee can pin a SNAPSHOT/rc and resolve it from a registry
            instead of building core from source. Scope the deploy the same way:

              ./mvnw -Pinternal-publish -DskipTests -pl core,addons/isva deploy

            Differences from `release`:
            - target is the org's private GitHub Packages Maven registry
              (distributionManagement below), not the Central Portal — no GPG
              signing and no staging/verify gate, so it stays cheap to run often.
            - it reuses the same flatten (flattenMode=ossrh) so the published POM
              is self-contained and resolves IDENTICALLY to the eventual Central
              artifact (consumers never need the unpublished aggregator parent).
            - the module build already attaches the test-jar, so that ships too
              (ee depends on ldapportal-core:test-jar).

            Auth: a `github` server (username + GITHUB_TOKEN with packages:write)
            in settings.xml — the publish-internal.yml workflow wires it. Stamp a
            real version first (the pom stays -SNAPSHOT for dev):

              ./mvnw versions:set -DnewVersion=0.1.5-SNAPSHOT -DgenerateBackupPoms=false
        -->
        <profile>
            <id>internal-publish</id>
            <distributionManagement>
                <repository>
                    <id>github</id>
                    <name>GitHub Packages (dir-IQ/ldapportal-core)</name>
                    <url>https://maven.pkg.github.com/dir-IQ/ldapportal-core</url>
                </repository>
                <snapshotRepository>
                    <id>github</id>
                    <name>GitHub Packages (dir-IQ/ldapportal-core)</name>
                    <url>https://maven.pkg.github.com/dir-IQ/ldapportal-core</url>
                </snapshotRepository>
            </distributionManagement>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>flatten-maven-plugin</artifactId>
                        <version>1.7.3</version>
                        <configuration>
                            <flattenMode>ossrh</flattenMode>
                        </configuration>
                        <executions>
                            <execution>
                                <id>flatten</id>
                                <phase>process-resources</phase>
                                <goals><goal>flatten</goal></goals>
                            </execution>
                            <execution>
                                <id>flatten-clean</id>
                                <phase>clean</phase>
                                <goals><goal>clean</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!--
            GitLab Maven Package Registry counterpart to `internal-publish`.
            Activated with `-Pgitlab-publish` from a GitLab CI job; publishes
            core + the open-source addons to the project's GitLab Maven registry
            so a downstream build (commercial/ee) can resolve a pre-release pin
            from a registry instead of building core from source — the GitLab
            analogue of the GitHub Packages path above. Scope it the same way:

              mvn -Pgitlab-publish -DskipTests -pl core,addons/isva deploy

            Like `internal-publish` (and unlike `release`): no GPG signing and no
            Central staging gate, and the SAME flattenMode=ossrh so the published
            POM is self-contained and resolves IDENTICALLY to the eventual Central
            artifact. Explicit `-P` activation (NOT env.GITLAB_CI auto-activation)
            is deliberate: the flatten + source-jar steps below must not perturb
            the ordinary GitLab test/package pipeline, only the publish job.

            URLs use GitLab's predefined CI_API_V4_URL / CI_PROJECT_ID. Auth is
            the job token via a CI-generated settings.xml whose `gitlab-maven`
            server sets a `Job-Token` HTTP header — no secret to manage. See
            docs/self-hosting-gitlab.md §6.
        -->
        <profile>
            <id>gitlab-publish</id>
            <distributionManagement>
                <repository>
                    <id>gitlab-maven</id>
                    <name>GitLab Maven Package Registry</name>
                    <url>${env.CI_API_V4_URL}/projects/${env.CI_PROJECT_ID}/packages/maven</url>
                </repository>
                <snapshotRepository>
                    <id>gitlab-maven</id>
                    <name>GitLab Maven Package Registry</name>
                    <url>${env.CI_API_V4_URL}/projects/${env.CI_PROJECT_ID}/packages/maven</url>
                </snapshotRepository>
            </distributionManagement>
            <build>
                <plugins>
                    <!-- Identical flatten + source-jar to `internal-publish`, so the
                         artifact published to GitLab resolves the same as the one
                         published to GitHub Packages / Central. -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>flatten-maven-plugin</artifactId>
                        <version>1.7.3</version>
                        <configuration>
                            <flattenMode>ossrh</flattenMode>
                        </configuration>
                        <executions>
                            <execution>
                                <id>flatten</id>
                                <phase>process-resources</phase>
                                <goals><goal>flatten</goal></goals>
                            </execution>
                            <execution>
                                <id>flatten-clean</id>
                                <phase>clean</phase>
                                <goals><goal>clean</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
