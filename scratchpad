  # Direct (non-WebSEAL) access: the /idm prefix reaches nginx, so serve
# the same bundle under it and proxy the prefixed API.
location /idm/api/v1/ {
    proxy_pass http://${BACKEND_APP}:8080/api/v1/;
    # No WebSEAL on this path to rewrite cookie paths, so do it here.
    proxy_cookie_path /api/v1 /idm/api/v1;
    proxy_cookie_path / /idm/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Not behind WebSEAL: never forward a client-supplied identity header.
    proxy_set_header iv-user "";
    proxy_set_header iv-groups "";
    proxy_set_header iv-creds "";
}

location /idm/ {
    alias /usr/share/nginx/html/;
    try_files $uri $uri/ /index.html;
}
