# 1. What role is the controller SA pointing at?
kubectl -n kube-system get sa efs-csi-controller-sa -o jsonpath='{.metadata.annotations.eks\.amazonaws\.com/role-arn}{"\n"}'

# 2. Is the cluster's OIDC provider registered in IAM? (GovCloud partition!)
aws eks describe-cluster --name <cluster> --region us-gov-west-1 \
  --query 'cluster.identity.oidc.issuer' --output text
aws iam list-open-id-connect-providers   # the issuer above must appear here

# 3. Which SA are the controller pods actually using?
kubectl -n kube-system get deploy efs-csi-controller \
  -o jsonpath='{.spec.template.spec.serviceAccountName}{"\n"}'
