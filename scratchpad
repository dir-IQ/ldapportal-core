# SPDX-License-Identifier: Apache-2.0
#
# TEMPORARY combined nginx template: serves the /idm-prefixed frontend image
# both behind a transparent-path WebSEAL junction (`create -x ... /idm`) and
# by direct access, from one pod.
#
# Trust note: this template forwards iv-user / iv-groups on every path, so the
# backend sees a WebSEAL identity whether the request came through WebSEAL or
# not. Anyone who can reach this pod directly can therefore forge iv-user.
# Only use it while the direct hostname is on the INTERNAL load balancer
# (VPN / bastion), and revert to the split admin + superadmin templates once
# the WebSEAL junction is working.
#
# NGINX_ENVSUBST_FILTER=BACKEND_APP (set in the image) keeps envsubst away
# from $1, $uri, $host and the other nginx runtime variables used here.
apiVersion: v1
kind: ConfigMap
metadata:
  name: ldapportal-frontend-nginx
  labels:
    app.kubernetes.io/name: ldapportal
    app.kubernetes.io/component: frontend
data:
  default.conf.template: |
    server {
        listen 8080;

        root /usr/share/nginx/html;
        index index.html;

        client_max_body_size 50m;

        # Bare prefix → canonical trailing slash so relative asset URLs resolve.
        location = /idm {
            return 301 /idm/;
        }

        # Prefixed API (what the /idm build actually calls). Forward to the
        # backend at its root path and map the backend's cookie paths
        # (Path=/api/v1, Path=/) onto the prefix, since neither a transparent
        # junction nor direct access rewrites them. If the browser ever shows
        # Path=/idm/idm/api/v1 after a WebSEAL sign-in, WebSEAL is rewriting
        # them too — delete the two proxy_cookie_path lines in that case.
        location /idm/api/v1 {
            proxy_pass http://${BACKEND_APP}:8080/api/v1;
            proxy_cookie_path /api/v1 /idm/api/v1;
            proxy_cookie_path / /idm/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            # iv-user / iv-groups pass through unchanged (see trust note).
        }

        # Prefixed SPA: drop the prefix internally so the root locations serve
        # the file, or fall back to index.html for deep links.
        location /idm/ {
            rewrite ^/idm/(.*)$ /$1 last;
        }

        # Unprefixed paths: health probes, and anything that still arrives at
        # the root (for example while the junction is a standard one).
        location /api/v1 {
            proxy_pass http://${BACKEND_APP}:8080;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location / {
            try_files $uri $uri/ /index.html;
        }
    }
